#!/usr/sbin/nft -f

# Edit the public interface name before loading this ruleset.
define mousevpn_wan = "eth0"
define mousevpn_net = 10.77.0.0/24

table inet mousevpn {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname $mousevpn_wan ip saddr $mousevpn_net masquerade
    }

    # Clamp the TCP handshake to what the tunnel can actually carry.
    #
    # Without this, a peer that never receives the "fragmentation needed" ICMP
    # keeps sending full-size segments: small requests succeed, large responses
    # stall, and the tunnel looks intermittently broken rather than misconfigured.
    chain forward {
        type filter hook forward priority mangle; policy accept;

        tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    }
}
