<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="40%"
                android:gradientRadius="58%"
                android:startColor="#FFF4A3"
                android:centerColor="#F2C300"
                android:endColor="#5A4500" />
            <stroke android:width="3dp" android:color="#FFF1A0"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="38%"
                android:gradientRadius="62%"
                android:startColor="#FFE873"
                android:centerColor="#F0C000"
                android:endColor="#4A3900" />
            <stroke android:width="3dp" android:color="#FFD72A"/>
        </shape>
    </item>
</selector>