            <solid android:color="#171717"/>
            <stroke android:width="2dp" android:color="#6A5700"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#111111"/>
            <stroke android:width="2dp" android:color="#4A3C00"/>
        </shape>
    </item>
</selector>