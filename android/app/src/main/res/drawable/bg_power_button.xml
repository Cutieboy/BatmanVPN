<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="#101D16" />
            <stroke android:width="1dp" android:color="@color/status_on" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#241717" />
            <stroke android:width="1dp" android:color="@color/status_off" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#141414" />
            <stroke android:width="1dp" android:color="@color/status_off" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
