<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/bg_card">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/domain_rules_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/domainRulesWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/domainRuleInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:hint="@string/domain_rules_input_hint"
            android:inputType="textUri"
            android:singleLine="true"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_input" />
        <Spinner
            android:id="@+id/domainRuleRoute"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input" />
        <Button
            android:id="@+id/addDomainRule"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/domain_rules_add"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/domainRulesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
