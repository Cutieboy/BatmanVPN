{
  "productName": "BatmanVPN",
  "version": "0.1.18",
  "identifier": "dev.mousevpn.windows",
  "build": {
    "frontendDist": "../../linux-gui/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BatmanVPN for Windows",
        "width": 920,
        "height": 620,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.svg"
    ],
    "category": "Utility",
    "shortDescription": "Fast private BatmanVPN client",
    "longDescription": "BatmanVPN desktop client for Windows",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
